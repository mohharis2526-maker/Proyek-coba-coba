<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="harsss"/>
        <attribute name="authors" value="NURA"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-29 12:33:58 AM"/>
        <attribute name="created" value="TlVSQTtERVNLVE9QLTZVUjlHTTg7MjAyNi0wOS0yODsxMDo0NDoxMCBQTTsyNjU4"/>
        <attribute name="edited" value="TlVSQTtERVNLVE9QLTZVUjlHTTg7MjAyNi0wOS0yOTsxMjozMzo1OCBBTTsyOzI3NjU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="totalbuku" type="Real" array="False" size=""/>
            <input variable="totalbuku"/>
            <declare name="totaljumlahbuku" type="Integer" array="False" size=""/>
            <declare name="hargasatuanbuku" type="Real" array="False" size=""/>
            <assign variable="hargasatuanbuku" expression="totalbuku/3"/>
            <output expression="&quot;harga satuan buku =&quot;&amp;hargasatuanbuku" newline="True"/>
            <declare name="totalpulpen" type="Real" array="False" size=""/>
            <input variable="totalpulpen"/>
            <declare name="totaljumlahpulpen" type="Integer" array="False" size=""/>
            <declare name="hargasatuanpulpen" type="Real" array="False" size=""/>
            <assign variable="hargasatuanpulpen" expression="totalpulpen/2"/>
            <output expression="&quot;harga satuan pulpen =&quot;&amp;hargasatuanpulpen" newline="True"/>
            <declare name="totalflashdisk" type="Real" array="False" size=""/>
            <input variable="totalflashdisk"/>
            <declare name="hargasatuanflashdisk" type="Real" array="False" size=""/>
            <assign variable="hargasatuanflashdisk" expression="totalflashdisk/1"/>
            <declare name="totaljumlahflashdisk" type="Integer" array="False" size=""/>
            <output expression="&quot;harga satuan flashdisk =&quot;&amp;hargasatuanflashdisk" newline="True"/>
            <declare name="totalsebelumdiskon" type="Real" array="False" size=""/>
            <assign variable="totalsebelumdiskon" expression="totalbuku+totalpulpen+totalflashdisk"/>
            <declare name="Diskon" type="Real" array="False" size=""/>
            <assign variable="Diskon" expression="totalsebelumdiskon*0.10"/>
            <declare name="hargasetelahdiskon" type="Real" array="False" size=""/>
            <assign variable="hargasetelahdiskon" expression="totalsebelumdiskon-diskon"/>
            <declare name="pajak" type="Real" array="False" size=""/>
            <assign variable="pajak" expression="hargasetelahdiskon*0.11"/>
            <declare name="totalbayar" type="Real" array="False" size=""/>
            <assign variable="totalbayar" expression="hargasetelahdiskon+pajak"/>
            <output expression="&quot;total bayar =&quot;&amp;totalbayar" newline="True"/>
            <declare name="uangdibayar" type="Real" array="False" size=""/>
            <input variable="uangdibayar"/>
            <declare name="kembalian" type="Real" array="False" size=""/>
            <assign variable="kembalian" expression="uangdibayar-totalbayar"/>
            <output expression="kembalian" newline="True"/>
        </body>
    </function>
</flowgorithm>
